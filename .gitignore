# 第三方代码与早期资料（git 外）
/vendor/*
!/vendor/README.md
/scratch/
backup

# 外部资产（软链）——锚定到仓库根，避免连带忽略 experiments 下同名的 data/ 目录
/data
/models

# 工具目录
__pycache__/
*.pyc
*.log

# experiments/ 工作产物
# 目录规则：experiments/<基座>/<实验域>/{config,scripts,weights,predictions,reports}
# 配置与报告进 git，权重/预测/缓存不入库
experiments/*/*/weights/
experiments/*/*/predictions/
experiments/*/*/reports/preds_*.jsonl
experiments/*/*/reports/eval_*.log
experiments/*/*/config/ckpt*.yaml
experiments/*/smoke/*.csv

# badcase_study：代码/配置/报告入库，派生数据集与图片软链不入库
# （weights/、predictions/、reports/preds_*.jsonl、*.log 已被上面的通用规则覆盖）
experiments/*/badcase_study/hardcase_data/*.jsonl
experiments/*/badcase_study/prompt_retrain_data/*.jsonl
experiments/*/badcase_study/*/images

# 工具缓存
experiments/llamaboard_cache/
